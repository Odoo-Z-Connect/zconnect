<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Operations see all assignments -->
        <record id="rule_dispatch_assignment_operations" model="ir.rule">
            <field name="name">Operations Dispatch Assignments</field>
            <field name="model_id" ref="model_zconnect_dispatch_assignment"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('zconnect_base.group_zconnect_dispatcher')), (4, ref('zconnect_base.group_zconnect_manager')), (4, ref('zconnect_base.group_zconnect_admin')), (4, ref('zconnect_base.group_zconnect_finance'))]"/>
        </record>

        <!-- Driver sees only their own assignments -->
        <record id="rule_dispatch_assignment_driver" model="ir.rule">
            <field name="name">Driver Own Dispatch Assignments</field>
            <field name="model_id" ref="model_zconnect_dispatch_assignment"/>
            <field name="domain_force">[('driver_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('zconnect_base.group_zconnect_driver'))]"/>
        </record>
        <!-- Driver sees shipments assigned to them -->
        <record id="rule_shipment_driver" model="ir.rule">
            <field name="name">Driver Own Shipments</field>
            <field name="model_id" ref="zconnect_shipment.model_zconnect_shipment"/>
            <field name="domain_force">[('current_driver_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('zconnect_base.group_zconnect_driver'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
