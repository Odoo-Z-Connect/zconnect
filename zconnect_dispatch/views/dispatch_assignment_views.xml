<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zconnect_dispatch_assignment_form" model="ir.ui.view">
        <field name="name">zconnect.dispatch.assignment.form</field>
        <field name="model">zconnect.dispatch.assignment</field>
        <field name="arch" type="xml">
            <form string="Dispatch Assignment">
                <header>
                    <button name="action_accept" type="object" string="Accept" class="oe_highlight" invisible="state != 'offered'" groups="zconnect_base.group_zconnect_driver,zconnect_base.group_zconnect_admin,zconnect_base.group_zconnect_dispatcher"/>
                    <button name="action_reject_wizard" type="object" string="Reject" invisible="state != 'offered'" groups="zconnect_base.group_zconnect_driver,zconnect_base.group_zconnect_admin,zconnect_base.group_zconnect_dispatcher"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,offered,accepted,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="shipment_id"/>
                            <field name="driver_id"/>
                            <field name="vehicle_id"/>
                        </group>
                        <group>
                            <field name="assigned_by"/>
                            <field name="assigned_at"/>
                            <field name="accepted_at" invisible="not accepted_at"/>
                            <field name="rejected_at" invisible="not rejected_at"/>
                        </group>
                    </group>
                    <group invisible="state != 'rejected'">
                        <field name="rejection_reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zconnect_dispatch_assignment_tree" model="ir.ui.view">
        <field name="name">zconnect.dispatch.assignment.tree</field>
        <field name="model">zconnect.dispatch.assignment</field>
        <field name="arch" type="xml">
            <list string="Dispatch Assignments" default_order="create_date desc">
                <field name="name"/>
                <field name="shipment_id"/>
                <field name="driver_id"/>
                <field name="vehicle_id"/>
                <field name="state" widget="badge" decoration-info="state == 'offered'" decoration-success="state in ('accepted', 'completed')" decoration-danger="state in ('rejected', 'cancelled')"/>
                <field name="assigned_at"/>
            </list>
        </field>
    </record>

    <record id="view_zconnect_dispatch_assignment_search" model="ir.ui.view">
        <field name="name">zconnect.dispatch.assignment.search</field>
        <field name="model">zconnect.dispatch.assignment</field>
        <field name="arch" type="xml">
            <search string="Search Dispatch Assignments">
                <field name="name"/>
                <field name="shipment_id"/>
                <field name="driver_id"/>
                <field name="vehicle_id"/>
                <separator/>
                <filter string="Offered" name="filter_offered" domain="[('state', '=', 'offered')]"/>
                <filter string="Accepted" name="filter_accepted" domain="[('state', '=', 'accepted')]"/>
                <separator/>
                <filter string="Group By State" name="group_by_state" context="{'group_by': 'state'}"/>
                <filter string="Group By Driver" name="group_by_driver" context="{'group_by': 'driver_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_zconnect_dispatch_assignment" model="ir.actions.act_window">
        <field name="name">Dispatch Assignments</field>
        <field name="res_model">zconnect.dispatch.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_zconnect_dispatch_assignment_search"/>
        <field name="context">{'search_default_filter_offered': 1, 'search_default_filter_accepted': 1}</field>
    </record>
</odoo>
