<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ── Customer Record Rule: Customer can ONLY see their own shipments ── -->
        <record id="rule_shipment_customer_own" model="ir.rule">
            <field name="name">ZConnect Shipment: Customer own shipments only</field>
            <field name="model_id" ref="model_zconnect_shipment"/>
            <field name="domain_force">[('customer_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[Command.link(ref('zconnect_base.group_zconnect_customer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ── Operations / Dispatcher: full access to all shipments ──────────── -->
        <record id="rule_shipment_dispatcher_all" model="ir.rule">
            <field name="name">ZConnect Shipment: Operations all shipments</field>
            <field name="model_id" ref="model_zconnect_shipment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                Command.link(ref('zconnect_base.group_zconnect_dispatcher')),
                Command.link(ref('zconnect_base.group_zconnect_manager')),
                Command.link(ref('zconnect_base.group_zconnect_admin'))
            ]"/>
        </record>

        <!-- ── Finance: read-only all shipments ───────────────────────────────── -->
        <record id="rule_shipment_finance_all" model="ir.rule">
            <field name="name">ZConnect Shipment: Finance read-only</field>
            <field name="model_id" ref="model_zconnect_shipment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('zconnect_base.group_zconnect_finance'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
