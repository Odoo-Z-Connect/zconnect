    <!-- ── Action ──────────────────────────────────────────────────────── -->
    <record id="action_zconnect_shipment" model="ir.actions.act_window">
        <field name="name">Shipments</field>
        <field name="res_model">zconnect.shipment</field>
        <field name="view_mode">list,map,form</field>
        <field name="search_view_id" ref="view_zconnect_shipment_search"/>
        <field name="context">{'search_default_confirmed': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Book your first Zimbabwe Connect shipment
            </p>
            <p>
                Enter pickup and delivery locations, specify cargo details, select a vehicle category,
                and calculate fare quotes with automated pricing snapshots.
            </p>
        </field>
    </record>

</odoo>
