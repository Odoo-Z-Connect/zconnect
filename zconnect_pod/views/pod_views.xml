<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zconnect_pod_form" model="ir.ui.view">
        <field name="name">zconnect.pod.form</field>
        <field name="model">zconnect.pod</field>
        <field name="arch" type="xml">
            <form string="Proof of Delivery">
                <header>
                    <button name="action_submit" type="object" string="Submit Delivery" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="shipment_id"/>
                            <field name="assignment_id"/>
                            <field name="driver_id"/>
                        </group>
                        <group>
                            <field name="recipient_name" readonly="state == 'submitted'"/>
                            <field name="recipient_phone" readonly="state == 'submitted'"/>
                            <field name="delivered_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Delivery Evidence">
                            <group>
                                <field name="delivery_notes" readonly="state == 'submitted'"/>
                                <field name="photo" widget="image" readonly="state == 'submitted'"/>
                                <field name="signature" widget="signature" readonly="state == 'submitted'"/>
                            </group>
                        </page>
                        <page string="GPS Details">
                            <group>
                                <field name="latitude" readonly="state == 'submitted'"/>
                                <field name="longitude" readonly="state == 'submitted'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_zconnect_pod_list" model="ir.ui.view">
        <field name="name">zconnect.pod.list</field>
        <field name="model">zconnect.pod</field>
        <field name="arch" type="xml">
            <list string="Proof of Delivery" default_order="create_date desc">
                <field name="name"/>
                <field name="shipment_id"/>
                <field name="driver_id"/>
                <field name="recipient_name"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'submitted'"/>
                <field name="delivered_at"/>
            </list>
        </field>
    </record>
    
    <record id="view_zconnect_pod_search" model="ir.ui.view">
        <field name="name">zconnect.pod.search</field>
        <field name="model">zconnect.pod</field>
        <field name="arch" type="xml">
            <search string="Search PODs">
                <field name="name"/>
                <field name="shipment_id"/>
                <field name="driver_id"/>
                <field name="recipient_name"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                <separator/>
                <filter string="Group By State" name="group_by_state" context="{'group_by': 'state'}"/>
                <filter string="Group By Driver" name="group_by_driver" context="{'group_by': 'driver_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_zconnect_pod" model="ir.actions.act_window">
        <field name="name">Proof of Delivery</field>
        <field name="res_model">zconnect.pod</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_zconnect_pod_search"/>
    </record>
</odoo>
