<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">paynow.payment.provider.form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'paynow'">
                    <field name="paynow_integration_id" required="code == 'paynow' and state != 'dummy'"/>
                    <field name="paynow_integration_key" password="True" required="code == 'paynow' and state != 'dummy'"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
