<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- ZConnect Module Category -->
        <record id="module_category_zconnect" model="ir.module.category">
            <field name="name">Zimbabwe Connect</field>
            <field name="description">Logistics, Freight, and Dispatch Management Roles for Zimbabwe Connect</field>
            <field name="sequence">50</field>
        </record>

        <!-- ZConnect Privilege Grouping -->
        <record id="res_groups_privilege_zconnect" model="res.groups.privilege">
            <field name="name">Logistics Operations</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_zconnect"/>
        </record>

        <!-- Customer Group (Portal/External) -->
        <record id="group_zconnect_customer" model="res.groups">
            <field name="name">Customer</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_zconnect"/>
            <field name="comment">External customers booking shipments, viewing quotes, tracking orders, and viewing invoices.</field>
        </record>

        <!-- Driver Group -->
        <record id="group_zconnect_driver" model="res.groups">
            <field name="name">Driver</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_zconnect"/>
            <field name="comment">Logistics drivers accepting assigned shipments, executing pickups/deliveries, and capturing Proof of Delivery.</field>
        </record>

        <!-- Dispatcher Group -->
        <record id="group_zconnect_dispatcher" model="res.groups">
            <field name="name">Dispatcher</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_zconnect"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Operations staff assigning drivers to shipments, managing routes, and monitoring active deliveries.</field>
        </record>

        <!-- Finance Group -->
        <record id="group_zconnect_finance" model="res.groups">
            <field name="name">Finance</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="res_groups_privilege_zconnect"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Staff managing customer billing, payments, driver payouts, and financial reconciliation.</field>
        </record>

        <!-- Manager Group (Inherits Dispatcher and Finance) -->
        <record id="group_zconnect_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">50</field>
            <field name="privilege_id" ref="res_groups_privilege_zconnect"/>
            <field name="implied_ids" eval="[(4, ref('group_zconnect_dispatcher')), (4, ref('group_zconnect_finance'))]"/>
            <field name="comment">Operations managers with full access to logistics configuration, analytics, and operational overrides.</field>
        </record>

        <!-- Administrator Group (Inherits Manager and System Admin) -->
        <record id="group_zconnect_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">60</field>
            <field name="privilege_id" ref="res_groups_privilege_zconnect"/>
            <field name="implied_ids" eval="[(4, ref('group_zconnect_manager')), (4, ref('base.group_system'))]"/>
            <field name="comment">Super administrators with complete control over the Zimbabwe Connect platform.</field>
        </record>
    </data>
</odoo>
