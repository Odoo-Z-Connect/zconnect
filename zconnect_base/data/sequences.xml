<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Customer Code Sequence -->
        <record id="seq_zconnect_customer_code" model="ir.sequence">
            <field name="name">ZConnect Customer Code</field>
            <field name="code">zconnect.customer.code</field>
            <field name="prefix">CUS-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
