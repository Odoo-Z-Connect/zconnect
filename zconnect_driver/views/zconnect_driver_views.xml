<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Driver List View ─────────────────────────────────────────────── -->
    <record id="view_zconnect_driver_list" model="ir.ui.view">
        <field name="name">zconnect.driver.list</field>
        <field name="model">zconnect.driver</field>
        <field name="arch" type="xml">
            <list string="Drivers" decoration-muted="availability_status == 'offline'"
                  decoration-success="verification_status == 'verified' and availability_status == 'available'"
                  decoration-warning="verification_status == 'pending'">
                <field name="driver_code"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="licence_class"/>
                <field name="verification_status" widget="badge"
                       decoration-success="verification_status == 'verified'"
                       decoration-warning="verification_status == 'pending'"
                       decoration-danger="verification_status == 'rejected'"
                       decoration-muted="verification_status == 'unverified'"/>
                <field name="availability_status" widget="badge"
                       decoration-success="availability_status == 'available'"
                       decoration-muted="availability_status == 'offline'"
                       decoration-warning="availability_status == 'unavailable'"/>
                <field name="primary_vehicle_id"/>
                <field name="document_count" string="Docs"/>
            </list>
        </field>
    </record>

    <!-- ── Driver Form View ─────────────────────────────────────────────── -->
    <record id="view_zconnect_driver_form" model="ir.ui.view">
        <field name="name">zconnect.driver.form</field>
        <field name="model">zconnect.driver</field>
        <field name="arch" type="xml">
            <form string="Driver Profile">
                <header>
                    <button name="action_submit_for_verification" type="object"
                            string="Submit for Verification"
                            class="btn-primary"
                            invisible="verification_status != 'unverified' and verification_status != 'rejected'"/>
                    <button name="action_verify" type="object"
                            string="Approve / Verify"
                            class="btn-success"
                            groups="zconnect_base.group_zconnect_manager"
                            invisible="verification_status != 'pending'"/>
                    <button name="action_reject" type="object"
                            string="Reject"
                            class="btn-danger"
                            groups="zconnect_base.group_zconnect_manager"
                            invisible="verification_status != 'pending'"/>
                    <button name="action_set_available" type="object"
                            string="Set Available"
                            invisible="availability_status == 'available' or verification_status != 'verified'"/>
                    <button name="action_set_unavailable" type="object"
                            string="Set Unavailable"
                            invisible="availability_status != 'available'"/>
                    <button name="action_set_offline" type="object"
                            string="Go Offline"
                            invisible="availability_status == 'offline'"/>
                    <field name="verification_status" widget="statusbar"
                           statusbar_visible="unverified,pending,verified"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_documents" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="driver_code" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="name" readonly="1"/>
                        </h2>
                    </div>
                    <group col="2">
                        <group string="Identity">
                            <field name="partner_id" options="{'no_quick_create': True}"/>
                            <field name="user_id" options="{'no_quick_create': True}"/>
                            <field name="phone" readonly="1"/>
                            <field name="email" readonly="1"/>
                            <field name="national_id"/>
                        </group>
                        <group string="Licence">
                            <field name="licence_class"/>
                            <field name="licence_number"/>
                            <field name="licence_expiry"
                                   decoration-danger="is_licence_expired"/>
                            <field name="is_licence_expired" widget="boolean" invisible="1"/>
                        </group>
                    </group>
                    <group col="2">
                        <group string="Availability">
                            <field name="availability_status" widget="badge"
                                   decoration-success="availability_status == 'available'"
                                   decoration-muted="availability_status == 'offline'"
                                   decoration-warning="availability_status == 'unavailable'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Vehicles" name="vehicles">
                            <field name="vehicle_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <group string="Primary Vehicle">
                                <field name="primary_vehicle_id" nolabel="1"/>
                            </group>
                        </page>
                        <page string="KYC Documents" name="documents">
                            <field name="document_ids" mode="list">
                                <list decoration-danger="is_expired" string="Documents">
                                    <field name="document_type"/>
                                    <field name="document_number"/>
                                    <field name="expiry_date"/>
                                    <field name="verification_status" widget="badge"
                                           decoration-success="verification_status == 'approved'"
                                           decoration-warning="verification_status == 'pending'"
                                           decoration-danger="verification_status == 'rejected'"/>
                                    <field name="is_expired" invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Driver Search View ───────────────────────────────────────────── -->
    <record id="view_zconnect_driver_search" model="ir.ui.view">
        <field name="name">zconnect.driver.search</field>
        <field name="model">zconnect.driver</field>
        <field name="arch" type="xml">
            <search>
                <field name="driver_code"/>
                <field name="partner_id"/>
                <field name="licence_number"/>
                <separator/>
                <filter string="Available" name="available"
                        domain="[('availability_status', '=', 'available')]"/>
                <filter string="Verified" name="verified"
                        domain="[('verification_status', '=', 'verified')]"/>
                <filter string="Pending Verification" name="pending"
                        domain="[('verification_status', '=', 'pending')]"/>
                <group>
                    <filter string="Verification Status" name="group_verification"
                            context="{'group_by': 'verification_status'}"/>
                    <filter string="Availability" name="group_availability"
                            context="{'group_by': 'availability_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Window Action ────────────────────────────────────────────────── -->
    <record id="action_zconnect_driver" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">zconnect.driver</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_zconnect_driver_search"/>
        <field name="context">{'search_default_verified': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a driver profile
            </p>
            <p>
                Link to an existing Contact to create a Zimbabwe Connect driver profile.
                The contact record holds personal details; this profile holds KYC, licence, and operational data.
            </p>
        </field>
    </record>

    <!-- ── Document Action (used by smart button) ───────────────────────── -->
    <record id="action_zconnect_driver_document" model="ir.actions.act_window">
        <field name="name">Driver Documents</field>
        <field name="res_model">zconnect.driver.document</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_driver_id': active_id}</field>
    </record>

</odoo>
