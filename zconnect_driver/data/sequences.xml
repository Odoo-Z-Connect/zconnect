<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Driver Code Sequence: DRV-00001, DRV-00002, ... -->
        <record id="seq_zconnect_driver_code" model="ir.sequence">
            <field name="name">ZConnect Driver Code</field>
            <field name="code">zconnect.driver.code</field>
            <field name="prefix">DRV-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
