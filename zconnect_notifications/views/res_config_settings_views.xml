<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.zconnect.notifications</field>
        <field name="model">res.config.settings</field>
        <!-- We inherit from the base settings form and inject into the General Settings area -->
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- In Odoo 19, SMS settings are usually under General Settings (module_sms) -->
            <xpath expr="//setting[@id='sms_settings']" position="after">
                <setting id="africastalking_settings" string="Africa's Talking API" help="Configure SMS delivery via Africa's Talking gateway. Overrides default Odoo IAP.">
                    <content>
                        <div class="row mt16">
                            <label for="zconnect_africastalking_username" class="col-4 col-lg-3 o_light_label"/>
                            <field name="zconnect_africastalking_username" class="oe_inline"/>
                        </div>
                        <div class="row mt8">
                            <label for="zconnect_africastalking_api_key" class="col-4 col-lg-3 o_light_label"/>
                            <field name="zconnect_africastalking_api_key" class="oe_inline" password="True"/>
                        </div>
                    </content>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
